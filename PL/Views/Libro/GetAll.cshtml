@model ML.Libro
@{
    ViewBag.Title = "GetAll";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Libros</h2>

<body>
    <div class="container">
        <div class="row">
            <div class="col-2">
                <a href="@Url.Action("Form", "Libro")" class="btn btn-primary">Nuevo libro</a>
            </div>
            <div class="col-2">
                <button type="button" class="btn btn-info" id="btnBuscar" onclick="AbrirFormBusqueda()">Buscar</button>
            </div>
            <div id="formBusqueda" style="display : none;">
                @using (Html.BeginForm("GetAll", "Libro", FormMethod.Post))
                {
                    <div class="container">
                        <div class="row">
                            <div class="col">
                                @Html.LabelFor(model => model.Titulo, "Titulo", new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
                            </div>
                            <div class="col">
                                @Html.LabelFor(model => model.AñoPublicacion, "Año de publicacion", new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.AñoPublicacion, new { @class = "form-control" })
                            </div>
                            <div class="col">
                                @Html.LabelFor(model => model.Autor.IdAutor, "Autor", new { @class = "form-label" })
                                @Html.DropDownListFor(model => model.Autor.IdAutor, new SelectList(Model.Autor.Autores, "IdAutor", "Nombre"), "Seleccione un autor", new { @class = "form-select" })
                            </div>
                            <div class="col">
                                @Html.LabelFor(model => model.Editorial.IdEditorial, "Editorial", new { @class = "form-label" })
                                @Html.DropDownListFor(model => model.Editorial.IdEditorial, new SelectList(Model.Editorial.Editoriales, "IdEditorial", "Nombre"), "Seleccione una editorial", new { @class = "form-select" })
                            </div>
                            <div>
                                <label>

                                </label>
                            </div>
                            <div class="row-cols-5">
                                <button type="submit" class="btn btn-primary">Buscar</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div>
                <div class="col-2">
                    <button type="button" class="btn btn-danger" id="btnEliminar" onclick="AbrirFormEliminar()">Eliminar libros por autor</button>
                </div>
                <div id="formEliminarPorAutor" style="display : none;">
                    @using (Html.BeginForm("DeleteByIdAutor", "Libro", FormMethod.Post))
                    {
                        <div class="container">
                            <div class="row">
                                <div class="col">
                                    @Html.LabelFor(model => model.Autor.IdAutor, "Autor", new { @class = "form-label" })
                                    @Html.DropDownListFor(model => model.Autor.IdAutor, new SelectList(Model.Autor.Autores, "IdAutor", "Nombre"), "Seleccione un autor", new { @class = "form-select" })
                                </div>
                                <div>
                                    <label>

                                    </label>
                                </div>
                                <div class="row-cols-5">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Estas seguro que deseas eliminar los libros del autor?');">Eliminar</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div>
                    <label>

                    </label>
                </div>
            </div>
            <div class="table-responsive col-12">
                @if (Model.Libros.Count > 0)
                {
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Titulo</th>
                                <th>Autor</th>
                                <th>Año de publicacion</th>
                                <th>Editorial</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ML.Libro libro in Model.Libros)
                            {
                                <tr>
                                    <td>@libro.Titulo</td>
                                    <td>@libro.Autor.Nombre</td>
                                    <td>@libro.AñoPublicacion</td>
                                    <td>@libro.Editorial.Nombre</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No se encontraron libros.
                    </div>
                }
            </div>
        </div>
    </div>
</body>

<script src="~/Scripts/jquery-3.7.0.js"></script>
<script>
    function AbrirFormBusqueda() {
        var form = $('#formBusqueda');
        form.toggle();
    }
    function AbrirFormEliminar() {
        var form = $('#formEliminarPorAutor');
        form.toggle();
    }
</script>